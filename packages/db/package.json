{
  "name": "@rop/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase migrations, generated types and database tests.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:start": "npx --yes supabase@3.2.0 start",
    "db:stop": "npx --yes supabase@3.2.0 stop",
    "db:reset": "npx --yes supabase@3.2.0 db reset",
    "db:demo": "docker exec -i supabase_db_rop psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/demo-history.sql",
    "db:types": "npx --yes supabase@3.2.0 gen types typescript --local --schema public,app > src/types.gen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:error-codes": "node scripts/check-error-codes.mjs",
    "check:rpc-registry": "node scripts/check-rpc-registry.mjs"
  },
  "devDependencies": {
    "@rop/config": "workspace:*",
    "@rop/core": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
