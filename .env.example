# Copy to .env (apps) or packages/db/.env (db tests). Values below are the local
# `supabase start` defaults for this repo's ports (see packages/db/supabase/config.toml).
# `pnpm db:start` prints the real keys; the anon/service keys shown are the CLI's
# long-standing local demo keys and are not secrets.

# Frontend (apps/operator, Vite)
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=

# Database tests (packages/db)
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 1 = fail instead of skip when the local stack is down (CI)
ROP_REQUIRE_STACK=
